# 本机服务
PORT=8788
HOST=127.0.0.1
DATABASE_PATH=./data/money-manager.sqlite
APP_TIMEZONE=Asia/Shanghai
# 自定义打开网址（可选，默认打开本机 http://127.0.0.1:8788；若配置了 Cloudflare Tunnel 域名可填写如 https://money.example.com）
# APP_URL=https://money.example.com

# 本地开发可关闭身份验证；正式运行必须使用 cloudflare
AUTH_MODE=disabled
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_MCP_AUD=
ALLOWED_EMAIL=

# OpenClaw MCP 的第二层应用令牌；正式环境必须填写足够长的随机值
MCP_API_TOKEN=

# DeepSeek（密钥只放在本机 .env，绝不要提交）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 备份
BACKUP_LOCAL_DIR=./backups/local
BACKUP_RETENTION_COUNT=14
BACKUP_AGE_RECIPIENT=
RCLONE_REMOTE=
RCLONE_BACKUP_PATH=MoneyManagerBackups
