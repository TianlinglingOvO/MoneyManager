# 本机服务
PORT=8788
HOST=127.0.0.1
DATABASE_PATH=./data/money-manager.sqlite
APP_TIMEZONE=Asia/Shanghai
# 自定义打开网址（可选，默认打开本机 http://127.0.0.1:8788；若配置了 Cloudflare Tunnel 域名可填写如 https://money.example.com）
# APP_URL=https://money.example.com

# 本地开发可关闭身份验证；正式运行必须使用 cloudflare
AUTH_MODE=disabled
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_MCP_AUD=
ALLOWED_EMAIL=

# OpenClaw MCP 的第二层应用令牌；正式环境必须填写足够长的随机值
MCP_API_TOKEN=

# 备份（本地快照建议放到与账本不同的物理硬盘，例如 E:/bak/SMB）
BACKUP_LOCAL_DIR=./backups/local
BACKUP_RETENTION_COUNT=14
BACKUP_AGE_RECIPIENT=
RCLONE_REMOTE=
RCLONE_BACKUP_PATH=MoneyManagerBackups
# 可选：访问 Google 需要代理时填写；SMB 自身不用，只传给 rclone
# HTTPS_PROXY=http://127.0.0.1:10809
# NO_PROXY=127.0.0.1,localhost

# 每日待办提醒：有待确认续费或临近计划时，SMB 调用 OpenClaw Gateway 的 /hooks/agent（留空即关闭）
# OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=
OPENCLAW_HOOK_AGENT_ID=main
OPENCLAW_REMINDER_CHANNEL=telegram
OPENCLAW_REMINDER_TO=
OPENCLAW_REMINDER_TIME=09:00
